-- ฟังก์ชันสร้างชื่อบนหัว
local function createNameTag(character, playerName)
	if not character:FindFirstChild("Head") then return end
	if character:FindFirstChild("CustomNameTag") then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "CustomNameTag"
	billboard.Adornee = character.Head
	billboard.Size = UDim2.new(0, 100, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = character

	local textLabel = Instance.new("TextLabel")
	textLabel.Parent = billboard
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.Font = Enum.Font.SourceSansBold
	textLabel.Text = playerName
	textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
	textLabel.TextSize = 16
	textLabel.TextStrokeTransparency = 0
end

-- ฟังก์ชันสร้างไฮไลต์แดง (ESP)
local function createHighlight(character)
	if character:FindFirstChild("CustomHighlight") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "CustomHighlight"
	highlight.Adornee = character
	highlight.FillColor = Color3.fromRGB(255, 0, 0)
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = character
end

local function setupPlayer(player)
	player.CharacterAdded:Connect(function(character)
		task.wait(1)
		if showNameTag then createNameTag(character, player.Name) end
		if showEsp then createHighlight(character) end
	end)
	if player.Character then
		if showNameTag then createNameTag(player.Character, player.Name) end
		if showEsp then createHighlight(player.Character) end
	end
end

-- ระบบตามติดเป้าหมายซ้ำๆ
local function stopTracking()
	trackingTarget = nil
	if trackingConnection then
		trackingConnection:Disconnect()
		trackingConnection = nil
	end
	if trackedButtonRef then
		trackedButtonRef.Text = "ปิด"
		trackedButtonRef.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		trackedButtonRef = nil
	end
end

local function startTracking(player, trackBtn)
	if trackingTarget == player then
		stopTracking()
		return
	end

	stopTracking()
	trackingTarget = player
	trackedButtonRef = trackBtn
	trackBtn.Text = "เปิด"
	trackBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)

	trackingConnection = RunService.RenderStepped:Connect(function()
		if trackingTarget and trackingTarget.Character and trackingTarget.Character:FindFirstChild("HumanoidRootPart") then
			local targetPart = trackingTarget.Character.HumanoidRootPart
			if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
				localPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
			end
		else
			stopTracking()
		end
	end)
end

-- อัปเดตรายชื่อผู้เล่น
local function updatePlayerList()
	stopTracking()
	for _, child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			setupPlayer(player)

			local pBtn = Instance.new("TextButton")
			pBtn.Parent = ScrollingFrame
			pBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			pBtn.Size = UDim2.new(1, -5, 0, 35)
			pBtn.Font = Enum.Font.SourceSansBold
			pBtn.Text = "       " .. player.Name
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.TextSize = 14
			pBtn.TextXAlignment = Enum.TextXAlignment.Left

			local icon = Instance.new("ImageLabel")
			icon.Parent = pBtn
			icon.BackgroundTransparency = 1
			icon.Position = UDim2.new(0, 3, 0, 2)
			icon.Size = UDim2.new(0, 31, 0, 31)
			icon.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"

			pBtn.MouseButton1Click:Connect(function()
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local targetPart = player.Character.HumanoidRootPart
					if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
						localPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
					end
				end
			end)

			local trackBtn = Instance.new("TextButton")
			trackBtn.Parent = pBtn
			trackBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
			trackBtn.Position = UDim2.new(1, -45, 0, 4)
			trackBtn.Size = UDim2.new(0, 40, 0, 27)
			trackBtn.Font = Enum.Font.SourceSansBold
			trackBtn.Text = "ปิด"
			trackBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			trackBtn.TextSize = 12

			trackBtn.MouseButton1Click:Connect(function()
				startTracking(player, trackBtn)
			end)
		end
	end
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(updatePlayerList)
